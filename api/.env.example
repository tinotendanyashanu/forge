FORGE_ENVIRONMENT=development
# JSON list of allowed browser origins (the browser does not call the API
# directly today; requests come from the Next.js server).
FORGE_CORS_ORIGINS=["http://localhost:3000"]
# Matches docker-compose.yml at the repo root (local development only).
FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@127.0.0.1:5434/forge
# Used by pytest; tables in this database are dropped and recreated.
FORGE_TEST_DATABASE_URL=postgresql+asyncpg://forge:forge@127.0.0.1:5434/forge_test

# ---- AI interviewer (Milestone 3) -------------------------------------------
# disabled | ollama | openai_compatible. Disabled: interviews run, answers are
# saved, and nothing is scored.
FORGE_LLM_PROVIDER=disabled
# Local Ollama (default base URL http://127.0.0.1:11434/v1):
#   FORGE_LLM_PROVIDER=ollama
#   FORGE_LLM_MODEL=qwen2.5:7b-instruct
# Ollama Cloud, or any OpenAI-compatible endpoint:
#   FORGE_LLM_PROVIDER=openai_compatible
#   FORGE_LLM_BASE_URL=https://ollama.com/v1
#   FORGE_LLM_API_KEY=<your key>          # server-side only, never sent to the browser
#   FORGE_LLM_MODEL=gpt-oss:120b
FORGE_LLM_MODEL=
FORGE_LLM_TIMEOUT_SECONDS=60
FORGE_LLM_MAX_RETRIES=2
FORGE_LLM_RETRY_BASE_DELAY=0.5
FORGE_LLM_RETRY_MAX_DELAY=4
FORGE_LLM_MAX_OUTPUT_TOKENS=1200
FORGE_LLM_TEMPERATURE=0.1
# auto | json_schema | json_object | none
FORGE_LLM_STRUCTURED_OUTPUT=auto
FORGE_LLM_MAX_REPAIR_ATTEMPTS=1
# Spending guards. Process-wide cap on model calls per hour across all learners
# and modules (0 disables it), and the per-learner interview limit.
FORGE_LLM_MAX_CALLS_PER_HOUR=600
FORGE_INTERVIEW_LLM_CALLS_PER_HOUR=60

# ---- Access ------------------------------------------------------------------
# No authentication exists: learner routes only answer loopback clients.
FORGE_LOCAL_ONLY=true
# Largest accepted request body in bytes (413 above it).
FORGE_MAX_REQUEST_BYTES=2000000

# ---- Coding lab execution (Milestone 5) — see docs/coding-lab.md -----------
# disabled | mock | docker. Only the worker (python -m app.coding.worker) runs code.
FORGE_SANDBOX_BACKEND=disabled
# Required for docker: acknowledges container-only isolation (single-user, local).
FORGE_SANDBOX_ALLOW_CONTAINER_ISOLATION=false
FORGE_SANDBOX_PYTHON_IMAGE=forge-sandbox-python:2
FORGE_SANDBOX_NODE_IMAGE=node:24-alpine
FORGE_SANDBOX_MAX_OUTPUT_BYTES=65536
FORGE_SANDBOX_MAX_TIME_MS=10000
FORGE_SANDBOX_MAX_MEMORY_MB=256
FORGE_SANDBOX_PIDS_LIMIT=64
FORGE_WORKER_POLL_SECONDS=1.0
FORGE_JOB_LEASE_SECONDS=90
FORGE_JOB_MAX_ATTEMPTS=3
FORGE_CODING_MAX_CODE_BYTES=65536
FORGE_CODING_RUNS_PER_MINUTE=10
FORGE_CODING_SUBMITS_PER_HOUR=30
FORGE_CODING_MAX_ACTIVE_JOBS=2

# System design lab (Milestone 6): per-learner AI calls per hour (messages, evaluations, drills)
FORGE_DESIGN_LLM_CALLS_PER_HOUR=60

# FORGE OPS (Milestone 7): per-learner AI calls per hour (commander messages, RCA and postmortem reviews)
FORGE_OPS_LLM_CALLS_PER_HOUR=60

# FORGE Workspace (Milestone 9): per-learner AI calls per hour (code reviews and collaboration exercises)
FORGE_WORKSPACE_LLM_CALLS_PER_HOUR=30
